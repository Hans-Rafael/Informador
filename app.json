{
  "expo": {
    "name": "InfoBarrio",
    "slug": "Informador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "informador",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.hansgarcia.infobarrio"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006874",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hansgarcia.infobarrio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006874",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "InfoBarrio usa tu ubicación para mostrarte lo que pasa cerca tuyo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InfoBarrio necesita acceso a tus fotos para adjuntarlas a tus noticias.",
          "cameraPermission": "InfoBarrio necesita la cámara para que saques fotos de lo que está pasando."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#006874"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e7f7c8a-edb1-436b-b05c-d35f33496ebe"
      }
    }
  }
}
